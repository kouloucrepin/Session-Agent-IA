# Modèle des secrets Streamlit.
# En local : copiez ce fichier en .streamlit/secrets.toml (jamais versionné).
# Sur Streamlit Cloud : collez ce contenu dans Settings → Secrets.
ANTHROPIC_API_KEY = "sk-ant-..."
APIFY_TOKEN = ""                 # vide = commerces fictifs de démonstration
APP_MOT_DE_PASSE = "atelier"     # conseillé en ligne : protège votre clé Anthropic
BUDGET_MAX_FCFA = "500"
# MODELE = "claude-sonnet-5-5"
# MODELE_RAPIDE = "claude-haiku-5-5"
