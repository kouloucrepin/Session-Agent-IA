# ================================================================
#  ATELIER AGENTS IA : VARIABLES D'ENVIRONNEMENT
#  Copiez ce fichier en .env puis collez vos valeurs après le signe =
#  Ne publiez jamais le fichier .env sur GitHub.
# ================================================================

# 1. Clé API Anthropic (OBLIGATOIRE)
#    Où la trouver : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 2. Jeton Apify pour la recherche Google Maps (RECOMMANDÉ)
#    Où le trouver : https://console.apify.com > Settings > API & Integrations
#    Laissé vide, les notebooks utilisent des commerces de démonstration.
APIFY_TOKEN=

# 3. Modèles utilisés (vous pouvez garder ces valeurs)
MODELE=claude-sonnet-5-5
MODELE_RAPIDE=claude-haiku-5-5

# 4. Acteur Apify utilisé pour Google Maps (vous pouvez garder cette valeur)
APIFY_ACTEUR=compass/crawler-google-places

# 5. Calcul des coûts (vérifiez les prix du jour sur la page tarifs d'Anthropic)
#    Prix en dollars par million de tokens, pour le modèle MODELE
PRIX_ENTREE_USD=3
PRIX_SORTIE_USD=15
TAUX_USD_FCFA=600
BUDGET_MAX_FCFA=500
